{
  "description": "Offer an update when GitHub has a newer version of these skills.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{ "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/update-check.sh"], "timeout": 5 }]
      }
    ]
  }
}
